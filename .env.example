# CallGuard — environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it is already in .gitignore.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Password shown at the Streamlit login gate.
# Leave empty to disable the gate (fine for local dev, NOT for public ngrok).
APP_PASSWORD=changeme

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Required for pyannote diarization.
# 1. Sign up at https://huggingface.co
# 2. Accept model licenses at:
#    https://huggingface.co/pyannote/speaker-diarization-3.1
#    https://huggingface.co/pyannote/segmentation-3.0
# 3. Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ── Whisper / ASR ─────────────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
WHISPER_MODEL=base
# Compute device: cpu | cuda | mps
COMPUTE_DEVICE=cpu
# Force a language (leave blank for auto-detect): en | hi | ur
WHISPER_LANGUAGE=
# ASR engine: whisperx (default) | indic | deepgram | assemblyai | google
ASR_ENGINE=whisperx
# Enable speaker diarization (requires HF_TOKEN)
USE_DIARIZATION=true

# Cloud ASR keys (only used when ASR_ENGINE matches)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Path to Google credentials JSON file
GOOGLE_CREDENTIALS=

# ── Audio preprocessing ───────────────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_LOUDNORM=true
AUDIO_HIGHPASS_HZ=80
AUDIO_NOISE_REDUCE=false
AUDIO_TRIM_SILENCE=true
AUDIO_SILENCE_MIN_LEN_MS=500

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=callguard.db

# ── Detection ─────────────────────────────────────────────────────────────────
KEYWORDS_PATH=pipeline/keywords.json
PHRASES_PATH=pipeline/phrases.json
FUZZY_THRESHOLD=80
CONTEXT_WINDOW_SIZE=4

# Fusion weights (keyword + semantic should sum to ~0.80; remainder for emotion)
WEIGHT_KEYWORD=0.45
WEIGHT_SEMANTIC=0.35
WEIGHT_EMOTION=0.10

# Score thresholds
FLAG_THRESHOLD=0.50
WARNING_THRESHOLD=0.60
EMERGENCY_THRESHOLD=0.80

# ── Semantic layer ─────────────────────────────────────────────────────────────
SEMANTIC_ENABLED=true
# Alternatives: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#               intfloat/multilingual-e5-small
SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_MIN_SCORE=0.45

# ── LLM judge (off by default) ────────────────────────────────────────────────
# Options: off | ollama | anthropic
LLM_JUDGE=off
LLM_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
LLM_BORDERLINE_LOW=0.40
LLM_BORDERLINE_HIGH=0.80
LLM_TIMEOUT_S=8

# ── Emotion / prosody (off by default) ────────────────────────────────────────
EMOTION_ENABLED=false
EMOTION_MODEL=speechbrain/emotion-recognition-wav2vec2-IEMOCAP

# ── Live monitor ──────────────────────────────────────────────────────────────
LIVE_MODEL=base
LIVE_CHUNK_SEC=4
LIVE_OVERLAP_SEC=1
LIVE_WARN_WINDOW_SEC=30

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_S=60
ALERT_EVIDENCE_SEC=30

# Telegram bot (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (leave SMTP_HOST blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_TO=recipient@example.com
SMTP_FROM=callguard@yourdomain.com

# Twilio SMS/WhatsApp (disabled by default)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890
TWILIO_TO=+0987654321

# ── Eval ──────────────────────────────────────────────────────────────────────
EVAL_RECALL_TARGET=0.80

# ── Speaker recognition ───────────────────────────────────────────────────────
RECOGNITION_THRESHOLD=0.75

# ── UI ────────────────────────────────────────────────────────────────────────
SHOW_DIAGNOSTICS_DEFAULT=false
